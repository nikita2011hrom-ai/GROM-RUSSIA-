@bot.message_handler(commands=['setlevel', 'ban', 'mute', 'warn', 'unmute', 'marry', 'divorce', 'partner'])
def mod_cmds(m):
    if m.chat.type == 'private': return
    cid, my_lvl = m.chat.id, get_lvl(m.chat.id, m.from_user.id)
    cmd = m.text.split()[0]
    
    if cmd == '/setlevel':
        if my_lvl < 4 or not m.reply_to_message: return
        try:
            nl = int(m.text.split()[1])
            if (my_lvl != 6 and nl > 3) or nl > 5: return
            admins_db.setdefault(str(cid), {})[str(m.reply_to_message.from_user.id)] = nl; save(ADMINS_FILE, admins_db)
            bot.reply_to(m, f"✅ Выдан {nl} уровень!")
        except: pass
    elif cmd == '/ban':
        if my_lvl < 4 or not m.reply_to_message or get_lvl(cid, m.reply_to_message.from_user.id) >= my_lvl: return
        try: bot.kick_chat_member(cid, m.reply_to_message.from_user.id, until_date=int(time.time()) + 60); bot.reply_to(m, "🔨 Кикнут.")
        except: pass
    elif cmd == '/mute':
        if my_lvl < 3 or not m.reply_to_message or get_lvl(cid, m.reply_to_message.from_user.id) >= my_lvl: return
        try:
            dur = p_time(m.text.split()[1]); until = int(time.time()) + dur if dur != "forever" else 0
            bot.restrict_chat_member(cid, m.reply_to_message.from_user.id, until_date=until, can_send_messages=False)
            bot.reply_to(m, "🔇 Замучен.")
        except: pass
    elif cmd == '/warn':
        if my_lvl < 2 or not m.reply_to_message or get_lvl(cid, m.reply_to_message.from_user.id) >= my_lvl: return
        c, t = str(cid), str(m.reply_to_message.from_user.id); warns_db.setdefault(c, {}).setdefault(t, 0); warns_db[c][t] += 1; save(WARNS_FILE, warns_db)
        if warns_db[c][t] >= 3:
            try: bot.restrict_chat_member(cid, t, until_date=int(time.time()) + 86400, can_send_messages=False); bot.reply_to(m, "⛔ 3/3. Мут 24ч."); warns_db[c][t] = 0; save(WARNS_FILE, warns_db)
            except: pass
        else: bot.reply_to(m, f"⚠️ Варн {warns_db[c][t]}/3")
    elif cmd == '/unmute':
        if my_lvl < 3 or not m.reply_to_message: return
        try: bot.restrict_chat_member(cid, m.reply_to_message.from_user.id, can_send_messages=True, can_send_media_messages=True, can_send_other_messages=True); bot.reply_to(m, "🔊 Размучен.")
        except: pass
    elif cmd == '/marry':
        if not m.reply_to_message: return
        u1, u2 = m.from_user, m.reply_to_message.from_user
        if u1.id == u2.id or u2.is_bot or str(u1.id) in marriages or str(u2.id) in marriages: return
        marriages[str(u1.id)], marriages[str(u2.id)] = {"partner": str(u2.id), "partner_name": u2.first_name}, {"partner": str(u1.id), "partner_name": u1.first_name}
        save(MARRIAGES_FILE, marriages); bot.reply_to(m, "💍 Поздравляем!")
    elif cmd == '/divorce':
        uid = str(m.from_user.id)
        if uid in marriages:
            p_id = marriages[uid]["partner"]; del marriages[uid]
            if p_id in marriages: del marriages[p_id]
            save(MARRIAGES_FILE, marriages); bot.reply_to(m, "💔 Развод.")
    elif cmd == '/partner':
        uid = str(m.from_user.id)
        bot.reply_to(m, f"💍 Супруг(а): {marriages[uid]['partner_name']}" if uid in marriages else "💔 Свободен.")

@bot.message_handler(content_types=['text'])
def handle_text(m):
    txt, uid = m.text, str(m.from_user.id)
    reg(m); u = users_db[uid]

    if txt == '⚙️ АДМИНКА' and m.from_user.id == ADMIN_ID:
        mk = types.InlineKeyboardMarkup(row_width=2).add(types.InlineKeyboardButton("📊 Стат", callback_data="stats"), types.InlineKeyboardButton("💰 Выдать", callback_data="give_money"), types.InlineKeyboardButton("📥 Заявки", callback_data="donates_check"))
        bot.send_message(m.chat.id, "Админка:", reply_markup=mk); return
    elif txt == '💸 Донат':
        mk = types.InlineKeyboardMarkup(row_width=1).add(*[types.InlineKeyboardButton(f"💎 {v['coins']} — {v['price']} ₽", callback_data=k) for k, v in PACKAGES.items()])
        bot.send_message(m.chat.id, "Пакеты:", reply_markup=mk); return
    elif txt == '💰 Мой баланс': bot.send_message(m.chat.id, f"💳 Баланс: *{u['balance']}*", parse_mode="Markdown"); return
    elif txt == '💼 Работать': eco_cmds(m); return
    elif txt == '🛒 Магазин': eco_cmds(m); return
    
    if m.chat.id in games:
        try:
            g = int(txt)
            if g == games[m.chat.id]["target"]:
                win = 50 if games[m.chat.id]["luck"] else 30; u["balance"] += win
                if games[m.chat.id]["luck"]: u["luck"] = False
                save(USERS_FILE, users_db); bot.send_message(m.chat.id, f"🎉 Угадал! +{win}"); del games[m.chat.id]
            else: bot.send_message(m.chat.id, "📉 Больше." if g < games[m.chat.id]["target"] else "📈 Меньше.")
        except: pass
    elif m.chat.type == 'private' and not txt.startswith('/'):
        low = txt.lower()
        if any(w in low for w in ['привет', 'ку']): bot.reply_to(m, random.choice(IRIS_GREET))
        elif 'как дела' in low: bot.reply_to(m, random.choice(IRIS_HOW))
        else: bot.reply_to(m, random.choice(IRIS_UNK))

@bot.callback_query_handler(func=lambda call: True)
def cb(call):
    uid = str(call.from_user.id); reg(call); u = users_db[uid]
    if call.data.startswith("donate_"):
        pk = PACKAGES[call.data]; did = str(int(time.time()))
        donates_db[did] = {"uid": uid, "name": u["name"], "amount": pk["coins"], "price": pk["price"], "status": "wait"}; save(DONATES_FILE, donates_db)
        bot.edit_message_text(f"💸 Оплата: {pk['price']} ₽\n\n{PAYMENT_INFO}", call.message.chat.id, call.message.message_id, reply_markup=types.InlineKeyboardMarkup().add(types.InlineKeyboardButton("✅ Я оплатил", callback_data=f"paid_{did}")))
    elif call.data.startswith("paid_"):
        did = call.data.split("_")[1]
        if did in donates_db:
            donates_db[did]["status"] = "check"; save(DONATES_FILE, donates_db)
            bot.answer_callback_query(call.id, "Отправлено!", show_alert=True)
            bot.send_message(ADMIN_ID, f"🔔 Донат: {donates_db[did]['name']} — {donates_db[did]['amount']} монет")
    elif call.data.startswith("open_"):
        idx = int(call.data.split("_")[1]); saper[uid]["opened"].append(idx)
        if idx in saper[uid]["mines"]:
            u["balance"] -= 20; save(USERS_FILE, users_db); del saper[uid]
            bot.edit_message_text("💥 БУМ! -20", call.message.chat.id, call.message.message_id)
        elif len(saper[uid]["opened"]) == 97:
            u["balance"] += 100; save(USERS_FILE, users_db); del saper[uid]
            bot.edit_message_text("🎉 ПОБЕДА! +100", call.message.chat.id, call.message.message_id)
        else: show_saper(uid, call.message.chat.id, call.message.message_id)
    elif call.data == "buy_vip" and u["balance"] >= 150: u["balance"] -= 150; u["vip"] = True; save(USERS_FILE, users_db); bot.answer_callback_query(call.id, "Куплено!", show_alert=True)
    elif call.data == "buy_luck" and u["balance"] >= 100: u["balance"] -= 100; u["luck"] = True; save(USERS_FILE, users_db); bot.answer_callback_query(call.id, "Куплено!", show_alert=True)
    elif call.data == "buy_theme" and u["balance"] >= 25: u["balance"] -= 25; save(USERS_FILE, users_db); bot.answer_callback_query(call.id, "Куплено!", show_alert=True)
    
    if call.from_user.id == ADMIN_ID:
        if call.data == "stats": bot.send_message(call.message.chat.id, f"Юзеров: {len(users_db)}"); bot.answer_callback_query(call.id)
        elif call.data == "give_money":
            msg = bot.send_message(call.message.chat.id, "Формат: `@user 500` или `me 500`"); bot.register_next_step_handler(msg, give_money)
        elif call.data == "donates_check":
            pend = [(k, v) for k, v in donates_db.items() if v["status"] == "check"]
            for did, d in pend:
                bot.send_message(call.message.chat.id, f"👤 {d['name']}\n💰 {d['amount']} ({d['price']} ₽)", reply_markup=types.InlineKeyboardMarkup().add(types.InlineKeyboardButton("✅ Да", callback_data=f"appr_{did}"), types.InlineKeyboardButton("❌ Нет", callback_data=f"rej_{did}")))
            bot.answer_callback_query(call.id)
        elif call.data.startswith("appr_"):
            did = call.data.split("_")[1]
            if did in donates_db:
                users_db[donates_db[did]["uid"]]["balance"] += donates_db[did]["amount"]; save(USERS_FILE, users_db)
                bot.edit_message_text("✅ Начислено.", call.message.chat.id, call.message.message_id); del donates_db[did]; save(DONATES_FILE, donates_db)

def give_money(m):
    if m.from_user.id != ADMIN_ID: return
    try:
        t, a = m.text.split(); a = int(a)
        t_id = str(ADMIN_ID) if t.lower() == "me" else next((k for k, v in users_db.items() if k == t.replace("@", "") or v["username"].lower() == t.replace("@", "").lower()), None)
        if t_id in users_db: users_db[t_id]["balance"] += a; save(USERS_FILE, users_db); bot.send_message(m.chat.id, f"✅ +{a}")
    except: pass

