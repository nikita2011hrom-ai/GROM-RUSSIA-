def reg(m):
    uid = str(m.from_user.id)
    if uid not in users_db:
        users_db[uid] = {"name": m.from_user.first_name, "username": m.from_user.username or "нет", "balance": 100, "vip": False, "luck": False, "last_work": 0}
        save(USERS_FILE, users_db)
    for k in ["balance", "vip", "luck", "last_work"]:
        if k not in users_db[uid]: users_db[uid][k] = 100 if k == "balance" else (0 if k == "last_work" else False)

def get_lvl(cid, uid):
    cid, uid = str(cid), str(uid)
    try:
        st = bot.get_chat_member(cid, uid).status
        if st == 'creator': return 6
        if st == 'administrator': return 5
    except: pass
    return admins_db.get(cid, {}).get(uid, 1)

def p_time(a):
    if not a: return None
    a = a.lower()
    if a in ["forever", "навсегда"]: return "forever"
    try:
        if a.endswith("m"): return int(a[:-1]) * 60
        if a.endswith("h"): return int(a[:-1]) * 3600
        if a.endswith("d"): return int(a[:-1]) * 86400
        if a.endswith("M"): return int(a[:-1]) * 2592000
        if a.endswith("y"): return int(a[:-1]) * 31536000
    except: pass
    return None

